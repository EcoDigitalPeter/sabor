{
  "info": {
    "_postman_id": "ottimizo-backend-collection",
    "name": "Ottimizo Backend (ottimizo)",
    "description": "Colecao Postman para o backend Java/Spring Boot do Ottimizzo (com.ottimizo, /api/v1/**). Login faz-se via Supabase Auth (nao contra o backend) e o token e guardado automaticamente na variavel de colecao {{access_token}}, usada por Bearer Auth em todos os outros pedidos. Ver README.md ao lado deste ficheiro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "supabase_url", "value": "https://fdbgtfafynvteakamkuf.supabase.co", "type": "string" },
    { "key": "supabase_anon_key", "value": "sb_publishable_FZgyFl-JT1I2weI5XVa4EA_D5IyYKl4", "type": "string" },
    { "key": "test_email", "value": "teste.integracao.1787308566098@gmail.com", "type": "string" },
    { "key": "test_password", "value": "", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "recipe_id", "value": "1", "type": "string" },
    { "key": "ingredient_id", "value": "1", "type": "string" },
    { "key": "store_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" },
    { "key": "product_id", "value": "1", "type": "string" },
    { "key": "order_id", "value": "1", "type": "string" },
